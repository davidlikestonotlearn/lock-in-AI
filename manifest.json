{
  "manifest_version": 3,
  "name": "Lock In Buddy",
  "version": "0.3.0",
  "description": "A local study buddy with a shared focus timer, study history, and dashboard on YouTube and Google Search.",
  "permissions": ["storage", "alarms"],
  "action": { "default_title": "Open Lock-In Buddy dashboard" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.google.com/*"
      ],
      "js": ["session.js", "storage.js", "appear.js", "buddy.js"],
      "css": ["styleBuddy.css"],
      "run_at": "document_idle"
    }
  ]
}
